# Origin of the Laravel API. No trailing slash and no "/api" (both are handled if present).
VITE_API_URL=http://127.0.0.1:8000

# Where the public marketplace gets its listings:
#   false (default) : the built-in demo listings. No backend is needed.
#   true            : the Laravel API at VITE_API_URL (start the backend first).
VITE_USE_API=false

# Show "demonstration data" notices in the footer and contact dialog. Set to false once the
# marketplace serves real listings. (Listings the API flags as demo always show the notice.)
VITE_DEMO_MODE=true
